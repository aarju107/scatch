<%- include('./partials/header') %>

<% if (locals.success && success.length > 0) { %>
<div class="absolute top-5 left-1/2 -translate-x-1/2 p-3 rounded-md bg-blue-500">
    <span class="text-white"><%= success %></span>
</div>
<% } %>

<div class="w-full min-h-screen flex items-start px-20 py-20 gap-10">

    <div class="w-[40%] flex flex-col gap-5">
        <h3 class="text-xl mb-2">Your Cart (<%= items.length %>)</h3>

        <% if (items.length === 0) { %>
            <p class="text-zinc-500">Your cart is empty. <a class="underline" href="/shop">Go shopping</a>.</p>
        <% } %>

        <% items.forEach(function (item) { %>
        <div class="w-full rounded-md overflow-hidden border">
            <div class="w-full h-60 flex items-center justify-center"
                 style="background-color: <%= item.bgcolor %>">
                <% if (item.image) { %>
                    <img class="h-full w-full object-contain" src="<%= item.image %>" alt="<%= item.name %>">
                <% } %>
            </div>
            <div class="w-full flex justify-between items-center px-5 py-4"
                 style="background-color: <%= item.panelcolor %>">
                <h3 class="text-xl" style="color: <%= item.textcolor %>"><%= item.name %></h3>
                <div class="flex items-center gap-3">
                    <span>&#8377; <%= item.price %></span>
                    <a class="text-red-600 text-sm underline"
                       href="/removefromcart/<%= item._id %>">Remove</a>
                </div>
            </div>
        </div>
        <% }) %>
    </div>

    <div class="w-[60%]">
        <h3 class="text-xl">Price Breakdown</h3>
        <div class="px-10 mt-5">
            <div class="flex mt-2">
                <h4 class="w-1/3">Total MRP</h4>
                <h4>&#8377; <%= totalMrp %></h4>
            </div>
            <div class="flex mt-2">
                <h4 class="w-1/3">Discount on MRP</h4>
                <h4>&#8377; <%= totalDiscount %></h4>
            </div>
            <div class="flex mt-2">
                <h4 class="w-1/3">Platform Fee</h4>
                <h4>&#8377; <%= platformFee %></h4>
            </div>
            <div class="flex mt-2">
                <h4 class="w-1/3">Shipping Fee</h4>
                <h4>FREE</h4>
            </div>
        </div>
        <div class="w-full h-[1px] bg-black mt-10"></div>
        <div class="flex mt-5">
            <h3 class="w-1/3 text-xl">Total Amount</h3>
            <h3 class="font-semibold text-xl text-green-600">&#8377; <%= bill %></h3>
        </div>
    </div>
</div>

<%- include('./partials/footer') %>