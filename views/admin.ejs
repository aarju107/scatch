<%- include('./partials/header') %>

<div class="w-full min-h-screen flex items-start px-20 py-20">
    <div class="w-[25%] flex flex-col items-start">
        <div class="flex flex-col">
            <a class="block w-fit mb-2 font-semibold" href="/owners/products">All Products</a>
            <a class="block w-fit mb-2" href="/owners/admin">Create new product</a>
            <a class="block w-fit mb-2 text-red-600" href="/owners/logout">Logout</a>
        </div>
    </div>

    <div class="w-[75%] flex flex-wrap gap-5">
        <% if (products.length === 0) { %>
            <p class="text-zinc-500">No products yet. <a class="underline" href="/owners/admin">Create one</a>.</p>
        <% } %>

        <% products.forEach(function (product) { %>
        <div class="w-60 border rounded overflow-hidden">
            <div class="w-full h-52 flex items-center justify-center"
                 style="background-color: <%= product.bgcolor %>">
                <% if (product.image) { %>
                    <img class="w-full h-full object-cover" src="<%= product.image %>" alt="<%= product.name %>">
                <% } %>
            </div>
            <div class="flex justify-between items-center px-4 py-4"
                 style="background-color: <%= product.panelcolor %>">
                <div style="color: <%= product.textcolor %>">
                    <h3><%= product.name %></h3>
                    <h4>&#8377; <%= product.price %></h4>
                </div>
            </div>
        </div>
        <% }) %>
    </div>
</div>

<%- include('./partials/footer') %>